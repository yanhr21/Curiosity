{
  "classification": "newton_native_lift_hold_metrics_schema_v1",
  "status": "schema_defined",
  "phase": "02_baselines",
  "source_namespaces": [
    "newton.panda.*",
    "newton.object.*",
    "newton.contact.*",
    "newton.camera.*",
    "candidate.controller.*"
  ],
  "required_episode_fields": [
    "newton.panda.step",
    "newton.panda.sim_time",
    "newton.panda.joint_q",
    "newton.panda.joint_qd",
    "newton.panda.joint_target_q",
    "newton.panda.object_body_q",
    "newton.panda.ee_body_q",
    "newton.panda.rigid_contact_count",
    "newton.camera.color_rgba",
    "newton.camera.depth",
    "candidate.controller.phase_index",
    "candidate.controller.commanded_gripper_target",
    "candidate.controller.commanded_lift_target"
  ],
  "metrics": {
    "success": {
      "lift_height_m": {
        "definition": "max object z minus initial object z",
        "threshold_min": 0.12
      },
      "hold_duration_s": {
        "definition": "continuous time above lift threshold after reaching target height",
        "threshold_min": 2.0
      },
      "max_slip_m": {
        "definition": "maximum lateral displacement during hold relative to first stable hold frame",
        "threshold_max": 0.025
      },
      "object_not_dropped": {
        "definition": "no drop-height-loss failure event after lift",
        "required": true
      }
    },
    "failure": {
      "drop_height_loss_m": {
        "threshold": 0.05
      },
      "under_grip_contact_loss_frames": {
        "threshold": 12
      },
      "over_force_contact_proxy_threshold": {
        "threshold": 140
      },
      "unstable_object_accel_m_s2": {
        "threshold": 8.0
      },
      "timeout_s": {
        "threshold": 8.0
      }
    },
    "adaptation": {
      "frames_until_success_after_mismatch": "not_applicable_for_no_adaptation_baseline",
      "success_per_contact_proxy_integral": "computed for comparison with later adaptive baselines"
    }
  },
  "report_columns": [
    "run_tag",
    "baseline_name",
    "scene",
    "tracked_object",
    "mass_label",
    "friction_label",
    "pose_seed",
    "status",
    "lift_height_m",
    "hold_duration_s",
    "max_slip_m",
    "object_not_dropped",
    "drop_height_loss_m",
    "contact_loss_frames",
    "max_contact_proxy",
    "max_object_accel_m_s2",
    "success_per_contact_proxy_integral",
    "manual_visual_inspection",
    "contact_sheet",
    "frame_browser",
    "summary_json",
    "npz"
  ],
  "forbidden_fields": [
    "observation.state",
    "action",
    "action_abs",
    "observation.images.*",
    "observation.tactile_f6",
    "observation.tactile_deform.*"
  ],
  "generated_trex_fields": [],
  "schema_promotion": "blocked"
}
