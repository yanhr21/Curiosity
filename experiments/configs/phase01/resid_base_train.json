{
  "classification": "phase01_no_curiosity_residual_adapter_trainer_config_v1",
  "phase": "phase01",
  "purpose": "Train the Phase 01 learned no-curiosity residual-controller baseline from the train-only advantage-gated corrective source manifest.",
  "method_name": "phase01_no_curiosity_newton_native_residual_controller_adapter",
  "not_official_trex_method": true,
  "not_trex_schema": true,
  "preflight_manifest": "data/processed/phase01/src/manifest.json",
  "output_dir": "experiments/outputs/phase01/core/resid/base",
  "checkpoint_dir": "checkpoints/phase01/core/resid/base",
  "requires_compute_node": true,
  "requires_fresh_official_newton_sanity": true,
  "schema_promotion": "blocked",
  "generated_trex_fields": [],
  "held_out_cells_reserved_for_evaluation": [
    "heldout_cup_full_low_hidden",
    "heldout_cup_empty_high_misleading",
    "heldout_box_heavy_low_large_offset",
    "heldout_cylinder_heavy_low_masked_vision"
  ],
  "architecture": {
    "type": "gru_residual_controller_sequence_model",
    "input_dim": 10,
    "hidden_dim": 512,
    "gru_layers": 2,
    "dropout": 0,
    "active_head": "binary_feedback_active_logit",
    "continuous_head": [
      "candidate.controller.feedback_lift_velocity_scale",
      "candidate.controller.feedback_hold_height_offset_m",
      "candidate.controller.feedback_stabilization_extension_s"
    ]
  },
  "feature_columns": [
    "newton.panda.sim_time",
    "newton.panda.rigid_contact_count",
    "newton.object.body_q.z",
    "candidate.controller.phase_index",
    "candidate.controller.commanded_gripper_target",
    "candidate.controller.commanded_lift_target",
    "candidate.task.object_mass_kg",
    "candidate.task.object_friction_mu",
    "candidate.modality.vision_available_mask",
    "candidate.modality.contact_available_mask"
  ],
  "target_columns": [
    "candidate.controller.feedback_active",
    "candidate.controller.feedback_lift_velocity_scale",
    "candidate.controller.feedback_hold_height_offset_m",
    "candidate.controller.feedback_stabilization_extension_s"
  ],
  "loss": {
    "feedback_active_bce_weight": 1,
    "continuous_mse_weight": 1
  },
  "optimizer": {
    "type": "adamw",
    "learning_rate": 0.0003,
    "weight_decay": 0.0001
  },
  "smoke": {
    "epochs": 3,
    "max_optimizer_steps": 12,
    "checkpoint_written": false,
    "valid_claim": "phase01_no_curiosity_residual_adapter_smoke_only_not_real_training_result"
  },
  "real_training": {
    "min_train_seconds": 3600,
    "min_gpu_utilization_percent": 30,
    "train_batch_repeat": 128,
    "monitor_interval_seconds": 30,
    "checkpoint_written": true,
    "valid_claim": "phase01_no_curiosity_residual_adapter_baseline_training_component_not_curiosity_success"
  },
  "attempt_ledger": "experiments/reports/phase01/core/training_attempts.json",
  "forbidden_claims": [
    "official_trex_method",
    "trex_schema_compatible",
    "curiosity_policy_updated",
    "held_out_generalization_before_eval",
    "curiosity_success_before_curiosity_weighted_training_and_heldout_eval"
  ]
}
