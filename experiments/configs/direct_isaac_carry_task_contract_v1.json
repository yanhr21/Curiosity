{
  "schema_version": "direct_isaac_carry_task_episode_v1",
  "purpose": "Bridge direct Isaac carry diagnostics to a future RL task without using hidden mass, center of mass, or retargeted pose as policy input.",
  "policy_observation": {
    "allowed": [
      "target_distance_x_m",
      "carry_posture_command",
      "video_reference_id",
      "reference_embedding_id",
      "probe_mode",
      "probe_belief_available",
      "probe_belief_source",
      "probe_risk_score",
      "probe_load_risk_bucket",
      "probe_recommended_carry_adjustment",
      "probe_tracking_errors",
      "probe_measured_effort_proxies",
      "support_foot_contact_report_state",
      "support_polygon_margin"
    ],
    "forbidden": [
      "box_mass_kg",
      "box_com_offset_m",
      "hidden_load_class",
      "human_joint_angles",
      "retargeted_robot_joint_targets",
      "copied_end_effector_trajectory"
    ]
  },
  "action_space": {
    "version": "posture_and_controller_params_v1",
    "discrete": [
      "carry_posture"
    ],
    "continuous": [
      "feedback_step_x_gain",
      "feedback_step_x_limit_m",
      "feedback_step_tilt_gain",
      "feedback_step_tilt_limit_m",
      "support_foot_double_support_fraction",
      "gait_speed_scale",
      "hold_height_adjustment_m",
      "stance_width_adjustment_m",
      "probe_steps",
      "probe_amplitude_x_m",
      "probe_amplitude_z_m"
    ]
  },
  "backend_capabilities": {
    "required_fields": [
      "backend_id",
      "backend_family",
      "isaac_backend",
      "free_dynamic_box",
      "randomized_box_properties",
      "active_probe_supported",
      "trainable_policy_backend",
      "real_robot_morphology",
      "support_switching_supported",
      "video_conditioning_supported",
      "root_shortcut_audited",
      "root_shortcut_free_claimed",
      "hidden_context_isolated",
      "scaffold_backend",
      "claim_limit",
      "shortcut_audit_fields"
    ],
    "current_backend_limit": "The current shell backend is an Isaac scaffold with a free dynamic box and active probing, but not a trainable walking robot backend."
  },
  "reward_terms": {
    "maximize": [
      "progress_reward",
      "balance_margin_reward"
    ],
    "minimize": [
      "target_distance_penalty",
      "fall_penalty",
      "drop_penalty",
      "contact_loss_penalty",
      "effort_proxy_penalty",
      "travel_loss_penalty",
      "rail_motion_penalty"
    ]
  },
  "termination": [
    "fall_events > 0",
    "box_drop_events > 0",
    "nonfinite_state_events > 0",
    "contact_report_required_but_missing",
    "episode_step_limit",
    "backend_error"
  ],
  "hidden_eval_context": [
    "box_seed",
    "box_mass_kg",
    "box_size_m",
    "box_com_offset_m",
    "box_mass_range_kg",
    "box_size_jitter_fraction"
  ],
  "claim_limit": "Rows from this contract are scaffold diagnostics until the controller is replaced by a real walking or trainable locomotion backend."
}
